---
layout: default
---
<style>
  :root { --global-theme-color: #376fac; --global-hover-color: #376fac; }
  .home-section { scroll-margin-top: 6rem; margin-bottom: 3rem; }
  .navbar-contacts { display: flex; align-items: center; gap: 0.65rem; }
  .navbar-contacts a { display: inline-flex; align-items: center; color: #111; }
  .navbar-contacts svg { width: 25px; height: 25px; fill: currentColor; }
  .navbar-contacts img { width: 32px; height: 28px; object-fit: contain; }
  .navbar-contacts a:hover { color: var(--global-theme-color); }
  .education-entry { margin-bottom: 1.5rem; }
  .education-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .education-details { margin-top: 0.25rem; }
  .publications ol.bibliography { list-style: decimal; padding-left: 1.7rem; }
  .publications ol.bibliography > li { display: list-item; padding-left: 0.4rem; margin-bottom: 1.5rem; }
  .publications ol.bibliography > li::marker { font-weight: 600; }
  .publication-title { font-weight: 600; }
  .publication-entry { line-height: 1.6; }
  .publication-links { margin-top: 0.2rem; }
  .publication-links a { margin-right: 0.8rem; }
</style>
<div class="post">
  <section id="about" class="home-section" aria-labelledby="about-heading">
    <header class="post-header">
      <h1 id="about-heading" class="post-title">{{ site.title }}</h1>
    </header>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% endif %}
          {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class alt=site.title cache_bust=true %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
    <div class="clearfix">{{ content }}</div>
  </section>

  <section id="news" class="home-section" aria-labelledby="news-heading">
    <h2 id="news-heading">News</h2>
    <div class="news table-responsive">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | sort: 'date' | reverse %}
        {% for item in news %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <details><summary>{{ item.title }}</summary>{{ item.content }}</details>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr><td>No news yet.</td></tr>
        {% endfor %}
      </table>
    </div>
  </section>

  <section id="publications" class="home-section" aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
    <div class="publications">
      {% bibliography %}
    </div>
  </section>

  <section id="education" class="home-section" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    {% for entry in page.education %}
      <div class="education-entry">
        <div class="education-heading">
          <strong>{% if entry.url %}<a href="{{ entry.url }}">{{ entry.institution }}</a>{% else %}{{ entry.institution }}{% endif %}</strong>
          <span>{{ entry.dates }}</span>
        </div>
        <div class="education-details">{{ entry.degree }}</div>
        <div>{{ entry.details }}</div>
      </div>
    {% endfor %}
  </section>

  <section id="miscellaneous" class="home-section" aria-labelledby="miscellaneous-heading">
    <h2 id="miscellaneous-heading">Miscellaneous</h2>
    <p>{{ page.miscellaneous }}</p>
  </section>
</div>

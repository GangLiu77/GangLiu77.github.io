@article{liu2026cigmae,
  author   = {Liu, Gang and Hao, Yanling and Zou, Yixuan},
  journal  = {IEEE Internet of Things Journal},
  title    = {{CIG-MAE}: Cross-Modal Information-Guided Masked Autoencoder for Self-Supervised {Wi-Fi} Sensing},
  year     = {2026},
  volume   = {13},
  number   = {16},
  pages    = {35614--35624},
  abstract = {Human action recognition (HAR) using Wi-Fi channel state information (CSI) has emerged as an attractive alternative to vision-based methods due to its ubiquity, device-agnostic nature, and inherent privacy-preserving capabilities. However, the high cost of manual annotation and the limited scale of publicly available CSI datasets restrict the performance of supervised approaches. Self-supervised learning (SSL) offers a promising avenue, but existing contrastive paradigms rely on data augmentations that conflict with the physical semantics of radio signals and require large-batch training, making them poorly suited for CSI. To overcome these challenges, we introduce a cross-modal information-guided masked autoencoder (CIG-MAE) that reconstructs both the amplitude and phase of CSI using a symmetric dual-stream architecture with a high masking ratio. Specifically, we propose an adaptive information-guided masking (AIM) strategy that dynamically allocates attention to time–frequency regions with high information density to improve learning efficiency, and we incorporate a Barlow Twins (BTs) regularizer to align cross-modal representations without negative samples. Experiments on three public datasets show that CIG-MAE consistently outperforms SOTA SSL methods and even surpasses a fully supervised baseline, demonstrating superior data efficiency, robustness, and representation generalization.},
  keywords = {Modeling;Wireless fidelity;Learning (artificial intelligence);Streams;Accuracy;Human activity recognition;Training;Self-supervised learning;Convolutional neural networks;Design methodology;Adaptive information-guided masking (AIM);cross-modal learning;human activity recognition;masked autoencoder;self-supervised learning (SSL);Wi-Fi sensing},
  doi      = {10.1109/JIOT.2026.3696504},
  issn     = {2327-4662},
  month    = {Aug},
  abbr     = {IOTJ}
}

